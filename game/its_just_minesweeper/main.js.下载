// IT'S JUST MINESWEEPER - app shell: canvas fit, mouse/touch input (the mirror board flips clicks back), loop, tab title, saves.
(function () {
'use strict';
const W = 1280, H = 720;
const cv = document.getElementById('c');
const ctx = cv.getContext('2d');
const qs = new URLSearchParams(location.search);
const app = { scale: 1, ox: 0, oy: 0, dpr: 1, muted: false };
const seed = +qs.get('seed') || (Date.now() % 100000) + 1;
let S = SIM.newGame(seed, +qs.get('level') || 0);
let last = 0, pressTimer = null, pressTile = -1, longPressed = false, titleT = 0;
const TS = +qs.get('timescale') || 1;   // capture hook: slow the game down
let save = {};
try { save = JSON.parse(localStorage.getItem('ijm.save') || '{}'); } catch (e) { }
R.endings = (save.endings || []).length || 0;

R.init((w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; });

function fit() {
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  const w = window.innerWidth, h = window.innerHeight;
  cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
  cv.style.width = w + 'px'; cv.style.height = h + 'px';
  const s = Math.min(cv.width / W, cv.height / H);
  app.scale = s; app.ox = (cv.width - W * s) / 2; app.oy = (cv.height - H * s) / 2; app.dpr = dpr;
  R.dev = { s, ox: app.ox, oy: app.oy };
}
window.addEventListener('resize', fit); fit();
const toLogical = e => ({ x: (e.clientX * app.dpr - app.ox) / app.scale, y: (e.clientY * app.dpr - app.oy) / app.scale });
// the mirror board is drawn flipped: turn a click on it back into the real square
function aim(p) {
  if (SIM.LEVELS[S.level].twist === 'mirror') { const g = R.layout(S); return { x: 2 * g.cx - p.x, y: p.y }; }
  return p;
}
function inRect(p, r) { return r && p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h; }

function press(p, button) {
  AU.resume();
  if (S.phase === 'ending') {
    if (inRect(p, R.endBtn)) { if (S.ending !== 'again') { S = SIM.newGame((Date.now() % 100000) + 1, 0); drain(); } else { SIM.again(S); drain(); } }
    return;
  }
  const a = aim(p);
  // the rest of the computer: Start, windows, icons, the minesweeper window's own buttons
  if (DESK.press(p, S, button)) return;
  const d = R.dialogRect();
  if (S.phase === 'won' || (S.phase === 'dead' && S.deathT > 0.9 && R.scare <= 0)) {
    if (inRect(p, d.ok) || inRect(p, d)) { R.okDown = true; setTimeout(() => { R.okDown = false; }, 120); AU.play('click'); SIM.ok(S); }
    return;
  }
  if (R.inSmiley(S, a.x, a.y) || R.inSmiley(S, p.x, p.y)) { R.smileyDown = true; setTimeout(() => { R.smileyDown = false; }, 150); AU.play('click'); SIM.smiley(S); return; }
  if (S.phase !== 'play') return;
  const i = R.tileAt(S, a.x, a.y);
  if (i < 0) return;
  if (button === 2) { SIM.flag(S, i); return; }
  if (button === 1) { SIM.chord(S, i); return; }
  AU.play('click');
  SIM.reveal(S, i);
}

cv.addEventListener('pointerdown', (e) => {
  try { window.focus(); } catch (_) { }
  const p = toLogical(e);
  R.mouse.x = p.x; R.mouse.y = p.y; R.mouse.touch = e.pointerType === 'touch';
  if (R.mouse.touch) {
    // long press = flag, tap = reveal
    R.mouse.down = true; longPressed = false; pressTile = p;
    clearTimeout(pressTimer);
    pressTimer = setTimeout(() => { longPressed = true; R.mouse.down = false; press(p, 2); if (navigator.vibrate) navigator.vibrate(20); }, 380);
    return;
  }
  press(p, e.button);
  R.mouse.down = e.button === 0 && !DESK.blocking() && !DESK.drag;
});
cv.addEventListener('pointerup', (e) => {
  R.mouse.down = false; DESK.up();
  if (e.pointerType === 'touch') { clearTimeout(pressTimer); if (!longPressed && pressTile) press(pressTile, 0); pressTile = null; }
});
window.addEventListener('pointermove', (e) => {
  const p = toLogical(e);
  R.mouse.x = p.x; R.mouse.y = p.y;
  DESK.move(p, S);
  if (e.pointerType) R.mouse.touch = e.pointerType === 'touch';
  if (R.mouse.touch && pressTile && Math.hypot(p.x - pressTile.x, p.y - pressTile.y) > 24) { clearTimeout(pressTimer); pressTile = null; }
});
cv.addEventListener('contextmenu', e => e.preventDefault());
window.addEventListener('keydown', (e) => {
  if (e.code === 'KeyM') AU.setMute(AU.on);
  if (e.code === 'F1' || e.code === 'F2' || e.code === 'Space') e.preventDefault();
  if (DESK.key(e.code, S)) return;
  if (e.code === 'Enter' || e.code === 'Space') { e.preventDefault(); if (S.phase === 'won' || S.phase === 'dead') SIM.ok(S); }
  if (e.code === 'F2') SIM.smiley(S);
});
R.onBeat = (k, n) => AU.play('heart', k);

function drain() {
  for (const e of S.ev) {
    R.onEvent(e, S);
    DESK.onEvent(e, S);
    AU.onEvent(e);
    if (e.type === 'level') document.title = e.tab;
    if (e.type === 'ending') {
      const set = new Set(save.endings || []); set.add(e.which);
      save.endings = [...set]; R.endings = set.size;
      if (!save.best || S.stats.time < save.best) save.best = S.stats.time;
      try { localStorage.setItem('ijm.save', JSON.stringify(save)); } catch (_) { }
      document.title = e.which === 'swept' ? 'Minesweeper' : 'Minesweeper (again)';
    }
  }
  S.ev.length = 0;
}

// the tab title fights back while you're away
document.addEventListener('visibilitychange', () => {
  last = 0;
  if (S.level >= 2 && S.phase !== 'ending') document.title = document.hidden ? 'come back' : SIM.LEVELS[S.level].tab;
});

function frame(ts) {
  requestAnimationFrame(frame);
  const dt = (last ? Math.min(0.05, (ts - last) / 1000) : 1 / 60) * TS;
  last = ts;
  if (!document.hidden) { if (!DESK.shut) SIM.step(S, dt); DESK.step(S, dt); }
  drain();
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.fillStyle = '#000'; ctx.fillRect(0, 0, cv.width, cv.height);
  ctx.setTransform(app.scale, 0, 0, app.scale, app.ox, app.oy);
  ctx.save(); ctx.beginPath(); ctx.rect(0, 0, W, H); ctx.clip();
  R.draw(ctx, S, app, dt);
  ctx.restore();
}
drain();
window.__ijm = { get S() { return S; }, SIM, R, AU, DESK, press, set S(v) { S = v; } };
requestAnimationFrame(frame);
})();
