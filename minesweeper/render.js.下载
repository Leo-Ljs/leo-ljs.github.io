  ctx.translate(W / 2 + (Math.random() - 0.5) * 30, H / 2 + (Math.random() - 0.5) * 30);
  ctx.scale(sc, sc);
  smileyFace(ctx, 0, 0, 170, 'hollow', { x: 0, y: 0 }, S);
  ctx.restore();
