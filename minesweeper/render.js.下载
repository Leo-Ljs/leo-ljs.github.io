// ---------- main draw ----------
R.draw = function (ctx, S, app, dt) {
  R.T += dt; R.beatT += dt;
  R.shake = Math.max(0, R.shake - dt * 40);
  R.flash = Math.max(0, R.flash - dt * 1.8);
  R.glitch = Math.max(0, R.glitch - dt);
  if (R.scare > 0) R.scare = Math.max(0, R.scare - dt / (R.scareLen || 1));
  R.cursor.x = R.mouse.x; R.cursor.y = R.mouse.y;
  // the mirror board is drawn flipped, so the square under the cursor is the flipped one
  const hx = S && SIM.LEVELS[S.level].twist === 'mirror' ? 2 * R.layout(S).cx - R.mouse.x : R.mouse.x;
  R.hoverTile = S ? R.tileAt(S, hx, R.mouse.y) : -1;

  ctx.save();
  if (R.shake > 0) ctx.translate((Math.random() - 0.5) * R.shake, (Math.random() - 0.5) * R.shake);
  desktop(ctx, S);
  const DK = G.DESK;
  if (S && S.phase !== 'ending' && (!DK || DK.visible())) {
    const g = R.layout(S);
    windowFrame(ctx, S, g);
    board(ctx, S, g);
    if (SIM.LEVELS[S.level].twist === 'night' && S.phase === 'play') night(ctx, S, g);
    if (S.blinkWarn) { ctx.fillStyle = 'rgba(0,0,0,' + (0.25 + 0.25 * Math.sin(R.T * 20)) + ')'; ctx.fillRect(0, 0, W, H - TASK); }
    if (S.level === 0 && !S.B.started && S.phase === 'play') {
      const bob = Math.sin(R.T * 3) * 3;
      const hx = g.wx + g.ww + 22, hy = g.by + 40 + bob;
      ctx.fillStyle = '#ffffe1'; ctx.fillRect(hx, hy, 230, 70); ctx.strokeStyle = '#000'; ctx.lineWidth = 1; ctx.strokeRect(hx + 0.5, hy + 0.5, 230, 70);
      ctx.beginPath(); ctx.moveTo(hx, hy + 18); ctx.lineTo(hx - 12, hy + 26); ctx.lineTo(hx, hy + 32); ctx.fillStyle = '#ffffe1'; ctx.fill();
      txt(ctx, R.mouse.touch ? 'Tap a square to begin.' : 'Click a square to begin.', hx + 12, hy + 17, '#000', "bold 13px Tahoma, Verdana, sans-serif");
      txt(ctx, 'Numbers = mines touching.', hx + 12, hy + 36, '#000', "13px Tahoma, Verdana, sans-serif");
      txt(ctx, R.mouse.touch ? 'Hold to plant a flag.' : 'Right-click to plant a flag.', hx + 12, hy + 54, '#000', "13px Tahoma, Verdana, sans-serif");
    }
  }
