    const g = R.layout(S);
    const t = S.fin.t;
    const line = t < 6 ? 'click me' : t < 13 ? 'click me. please.' : 'or don\'t. i can wait.';
    const sm = g.smiley;
    const bx = g.wx + g.ww + 18, by = sm.y + 8;
    ctx.fillStyle = '#ffffe1'; ctx.fillRect(bx, by, 200, 40); ctx.strokeStyle = '#000'; ctx.lineWidth = 1; ctx.strokeRect(bx + 0.5, by + 0.5, 200, 40);
