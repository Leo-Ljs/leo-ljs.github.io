};

function overlays(ctx, S, dt) {
  if (S.phase === 'won') {
    const st = S.story;
    if (st.stage === 2) dialog(ctx, '', [st.next], 'face', 'OK', true);
    else dialog(ctx, 'Minesweeper', [S.level === 0 ? 'Congratulations! You won.' : 'You won.', F_('Time: {0} seconds', Math.floor(st.time))], 'info', 'OK', false);
  } else if (S.phase === 'dead' && S.deathT > 0.9 && R.scare <= 0) {
    if (S.level === 0) dialog(ctx, 'Minesweeper', ['Game over.', 'Try again?'], 'info', 'OK', false);
    else dialog(ctx, 'Minesweeper', ["It's just minesweeper."], 'face', 'Try again', true);
